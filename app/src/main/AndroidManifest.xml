<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network is optional command transport; Blender computation remains local. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:allowBackup="false" android:label="Render" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".agent.AgentActivity" android:exported="true" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".agent.AgentService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started visible remote-command session for this app's native project operations, with persistent notification and Stop control; no control of unrelated apps" />
        </service>
        <service android:name=".agent.RenderLongForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Owner-started native Blender animation rendering with a persistent notification, Pause control and checkpointed recovery" />
        </service>
        <!-- Android work notification can only target this non-exported Stop receiver. -->
        <receiver android:name=".agent.NativeWorkStopReceiver" android:exported="false" />
        <service android:name=".agent.FileTransferService" android:exported="false" android:foregroundServiceType="dataSync" />
    </application>
</manifest>
