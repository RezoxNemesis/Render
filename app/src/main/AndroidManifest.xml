<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Explicit known app visibility for same-phone VideoStudio native MCP. -->
    <queries>
        <package android:name="com.rezoxnemesis.videostudio" />
    </queries>
    <!-- Network is optional command transport; Blender computation remains local. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:allowBackup="false" android:label="Render" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".agent.AgentActivity" android:exported="true" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".agent.AgentService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started visible remote-command session for this app's native project operations, with persistent notification and Stop control; no control of unrelated apps" />
        </service>
        <!-- Cross-app native bridge. Messenger checks caller's kernel-supplied UID
             and local owner-enabled flag before accepting typed commands. -->
        <service
            android:name=".agent.VideoStudioNativeBridgeService"
            android:exported="true" />
    </application>
</manifest>
